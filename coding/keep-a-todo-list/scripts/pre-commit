#!/usr/bin/env python3
"""Example hook for a project-local scripts/todo.py; preserve existing hooks."""

from pathlib import Path
import subprocess
import sys


def main():
    root = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True,
        encoding="utf-8", check=False,
    )
    if root.returncode:
        print(root.stderr, end="", file=sys.stderr)
        return root.returncode
    directory = Path(root.stdout.strip())
    return subprocess.call([
        sys.executable, str(directory / "scripts" / "todo.py"),
        "--file", str(directory / "TODO.json"),
        "validate", "--staged", "--if-present",
    ], cwd=directory)


if __name__ == "__main__":
    sys.exit(main())
