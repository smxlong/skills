FROM alpine:3.22
RUN apk add --no-cache qemu-system-x86_64 qemu-img qemu-guest-agent \
    linux-virt busybox-static openssh python3 cpio e2fsprogs dosfstools xorriso \
    iproute2 iproute2-tc nftables conntrack-tools tcpdump socat dnsmasq iputils
WORKDIR /lab
CMD ["python3", "/skill/scripts/lab.py", "--work", "/lab/run"]
